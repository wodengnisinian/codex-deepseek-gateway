    "h11",
    "websockets",
    "websockets.legacy",
    "dotenv",
    "asyncio",
    "logging",
    "queue",
    "uuid",
]

a = Analysis(
    [r"scripts\launcher_pyside6.py"],
    pathex=[r"C:\Users\xxs\Desktop\CDG"],
    binaries=[],
    datas=[
        (r"app_icon.ico", "."),
        (r"app_icon.png", "."),
        (r"codex", "codex"),
    ],
    hiddenimports=hiddenimports + collect_submodules("adapters"),
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
