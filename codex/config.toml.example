# =============================================================================
# Codex DeepSeek Gateway - 配置模板
# 复制到 %USERPROFILE%\.codex\config.toml 后运行 scripts\apply_codex_all.ps1
# =============================================================================
#
# 让Codex Desktop -> http://127.0.0.1:3688/v1 -> 网关 -> DeepSeek API
#
# 两种模式选择一个即可:
#   [模式一] 直连 — Codex Desktop 侧边栏 UI 直接配置
#   [模式二] 填入 OpenAI 密钥框 + 环境变量 GATEWAY_AUTH_TOKEN
# =============================================================================


# =============================================================================
# [模式一] 直接 API-Key 模式（推荐）
# =============================================================================
model_provider = "deepseek_gateway"

model = "deepseek-v4-flash"                              # 基础模型，日常编码推荐
model_reasoning_effort = "high"                          # low | medium | high | xhigh
model_reasoning_summary = "none"
model_supports_reasoning_summaries = false
hide_agent_reasoning = true
personality = "pragmatic"

[model_providers.deepseek_gateway]
name = "DeepSeek Gateway"
base_url = "http://127.0.0.1:3688/v1"
wire_api = "responses"                                   # 网关
env_key = "DEEPSEEK_API_KEY"
models = ["deepseek-v4-flash", "deepseek-v4-pro", "deepseek-chat", "deepseek-reasoner"]
request_max_retries = 3
stream_max_retries = 3
stream_idle_timeout_ms = 300000

# =============================================================================
# [模式二] Plugin-Compatible 模式
# 填入 Codex 侧边栏 OpenAI 密钥框即可
#
# 额外设置三个环境变量:
#   [Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY", "sk-xxx", "User")
#   [Environment]::SetEnvironmentVariable("GATEWAY_AUTH_TOKEN", "token", "User")
#   [Environment]::SetEnvironmentVariable("GATEWAY_MODEL_PROVIDER", "deepseek_gateway_plugin_mode", "User")
# =============================================================================
# model_provider = "deepseek_gateway_plugin_mode"
# [model_providers.deepseek_gateway_plugin_mode]
# name = "DeepSeek Gateway Plugin Mode"
# base_url = "http://127.0.0.1:3688/v1"
# wire_api = "responses"
# requires_openai_auth = true
# experimental_bearer_token = "local-gateway-token"
# models = ["deepseek-v4-flash", "deepseek-v4-pro", "deepseek-chat", "deepseek-reasoner"]
# request_max_retries = 3
# stream_max_retries = 3
# stream_idle_timeout_ms = 300000
